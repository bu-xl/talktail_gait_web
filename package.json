{
  "name": "gait-pressure-viewer",
  "version": "1.0.0",
  "description": "Real-time heatmap viewer for a 40x40 USB-serial pressure mat (90x180cm, 1:2).",
  "author": "TalkTail",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron": "npm run electron:build && electron dist-electron/electron/main.js",
    "electron:dev": "npm run electron:build && VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/electron/main.js",
    "pack": "npm run build && npm run electron:build && electron-builder --dir",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win --x64",
    "dist:win:exe": "npm run build && npm run electron:build && electron-builder --win portable --x64",
    "dist:win:portable": "npm run dist:win:exe",
    "dist:win:setup": "npm run build && npm run electron:build && electron-builder --win nsis --x64",
    "dist:win:zip": "npm run build && npm run electron:build && electron-builder --win zip --x64",
    "dist:mac": "npm run build && npm run electron:build && electron-builder --mac"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.1",
    "@types/node": "^20.19.43",
    "@types/w3c-web-serial": "^1.0.8",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.talktail.gait-pressure-mat",
    "productName": "GaitPressureMat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**",
      "**/*.node"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "extraResources": [
      {
        "from": "build/WINDOWS-INSTALL.txt",
        "to": "WINDOWS-INSTALL.txt"
      }
    ],
    "win": {
      "artifactName": "GaitPressureMat-${version}-Win64.${ext}",
      "executableName": "GaitPressureMat",
      "icon": "build/icon.ico",
      "publisherName": "TalkTail",
      "legalTrademarks": "GaitPressureMat",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "GaitPressureMat-${version}-Win64.${ext}"
    },
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "GaitPressureMat-${version}-Mac.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GaitPressureMat",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "GaitPressureMat-Setup-${version}-Win64.${ext}",
      "warningsAsErrors": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
