# Optional overrides (Vite). Copy values into `.env` (gitignored).
#
# VITE_API_BASE_URL — public API prefix (keep /api when the domain requires it)
#   OK:  https://gait.o-r.kr/api
#   OK:  http://133.186.220.74:3000
#   OK:  http://localhost:3000
#
# Paths like /api/results/... and /api/ai-results/... are joined without
# producing /api/api/ when the base already ends with /api.
#
# VITE_API_BASE_URL=https://gait.o-r.kr/api
# VITE_WS_URL=wss://gait.o-r.kr/ws
# VITE_SYNC_ROOM_ID=gait-default
