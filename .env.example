# Optional overrides (Vite). Leave unset to use config.json sync section.
#
# LOCAL DEV (copy to .env — gitignored):
#   VITE_API_BASE_URL=http://localhost:3000
#   VITE_WS_URL=ws://localhost:3000/ws
#   VITE_SYNC_ROOM_ID=gait-default
#
# Do NOT put localhost into config.json if you commit front_web — that file is tracked.
# H100/Electron builds keep using config.json sync.apiBaseUrl.

# VITE_API_BASE_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:3000/ws
# VITE_SYNC_ROOM_ID=gait-default
#
# UI mock without ai-server (fills panes from public/placeholders after Stop):
# VITE_SIMULATE_AI=1
